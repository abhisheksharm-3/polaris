#!/usr/bin/env bash
# UserPromptSubmit: classify what was described and open the run for it.
#
# This is the hook that ends hand invocation. Every Polaris path used to start with a typed
# command, so the work followed a Polaris path only on the days the user remembered a path existed
# and picked the right one.
#
# It announces the flow and it seeds the ledger, and the second half is the one that matters.
# additionalContext is text the model may ignore; a seeded ledger is state the phase gates read and
# refuse against. A version of this hook that only described the route would suggest better and
# enforce nothing.
#
# It is also the recovery path after a /clear. advance-flow recommends the clear at an approval stop;
# this hook is what makes the clear cheap, because it names the run, the phase, and the artifact the
# next phase reads on the first prompt after it.
#
# Fail open throughout. A misroute costs a sentence; a hook that errors on every prompt costs the
# session. Nothing here writes into a project that has no .polaris/config.json, because a project
# that never ran setup did not ask for a ledger.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
cfg="${PROJECT_DIR}/.polaris/config.json"

[ -f "$cfg" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

payload="$(cat | jq -s '.[0] // {}' 2>/dev/null)" || exit 0
[ -n "$payload" ] || exit 0
prompt="$(printf '%s' "$payload" | jq -r '.prompt // ""' 2>/dev/null)"

emit() { jq -cn --arg c "$1" '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$c}}'; }

context=""

if jq -e '.routing != false' "$cfg" >/dev/null 2>&1 && [ -n "$prompt" ]; then
    open="$(CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" get 2>/dev/null || true)"
    if [ -n "$open" ]; then
        # A prompt arriving mid-run is input to that run. Opening a second ledger would give the
        # phase gate two answers to what phase this is, and it would take the more permissive one.
        slug="$(printf '%s' "$open" | jq -r .slug)"
        flow="$(printf '%s' "$open" | jq -r .flow)"
        phase="$(printf '%s' "$open" | jq -r .current)"
        recorded="$(printf '%s' "$open" \
            | jq -r '[.record[] | select(.status=="done" and ((.artifact // "") != ""))] | sort_by(.at) | (last // {}) | .artifact // ""' 2>/dev/null)"
        context="Polaris run '${slug}' is open: the ${flow} flow, currently on phase '${phase}'. Treat this prompt as input to that run. Do not start another. Use /polaris:pause to abandon it."
        if [ -n "$recorded" ] && [ -f "$recorded" ]; then
            context="${context}
The last recorded phase left ${recorded} on disk, hash-locked in the ledger. Read it for what the earlier phases settled rather than reconstructing it from this conversation, which may have been cleared."
        fi
    else
        class="$(printf '%s' "$prompt" | bash "${ROOT}/scripts/route-prompt.sh" 2>/dev/null || echo unknown)"
        case "$class" in
            conversation) : ;;
            unknown)
                # The catalog holds the shapes that recur, and most work is not one of them. Handing
                # the prompt back unrouted is the fragmentation this hook exists to end, so an
                # unrecognized task gets a flow composed for it rather than a menu.
                table="$(jq -r 'to_entries[] | select(.value.phases | length > 0) | "  \(.key): \([.value.phases[].name] | join(" -> "))"' "${ROOT}/rules/flows.json" 2>/dev/null)"
                context="Polaris found no catalog flow for this prompt.
If it is a question, answer it and open nothing. Otherwise run /polaris:compose to build a flow for it from the installed agents and commands, then seed and announce it before starting.
Use a catalog row instead if one actually fits:
${table}"
                ;;
            *)
                slug="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]' \
                    | tr -c '[:alnum:]' ' ' | awk '{for(i=1;i<=4&&i<=NF;i++)printf "%s%s",$i,(i<4&&i<NF?"-":"")}' | cut -c1-40)"
                [ -n "$slug" ] || slug="run"
                if CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" seed "$class" "$slug" >/dev/null 2>&1; then
                    phases="$(jq -r --arg f "$class" '[.[$f].phases[] | .name + (if .approve then " (stop for approval)" else "" end)] | join(" -> ")' "${ROOT}/rules/flows.json")"
                    first="$(jq -r --arg f "$class" '.[$f].phases[0] | "\(.name) via \(.run)"' "${ROOT}/rules/flows.json")"
                    context="Polaris routed this to the ${class} flow and opened run '${slug}'.
Phases: ${phases}
Start with: ${first}
Record each phase with scripts/run-state.sh record <phase> <artifact> <evidence>. If this is the wrong flow, say so and run /polaris:pause."
                fi
                ;;
        esac
    fi
fi

# Nothing here judges whether the prompt is clear enough to act on. That check lived in this hook,
# then moved to a small-model veto beside it, and is now gone from both: it cost a model call on
# every prompt and a real turn on every false stop. An unclear prompt is answered with a question,
# in the turn, where the user can see the reasoning and argue with it.

[ -n "$context" ] && emit "$context"
exit 0
