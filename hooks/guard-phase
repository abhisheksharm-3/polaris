#!/usr/bin/env bash
# PreToolUse on Task: refuse a dispatch the open run's current phase does not name.
#
# This is where a seeded flow stops being a suggestion. The ledger says the run is on 'spec'; a
# dispatch to a builder is then not a judgment call the session gets to make, it is denied.
#
# It gates only a phase whose catalog target is a specific agent. A phase that runs a command or a
# workflow legitimately fans out to many agents, and a phase marked inline or specialist names no
# agent at all, so gating those would refuse work the flow asked for. Enforce where the catalog is
# specific; stay out of the way where it is not.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

command -v jq >/dev/null 2>&1 || exit 0
[ -f "${PROJECT_DIR}/.polaris/config.json" ] || exit 0
jq -e '.routing != false' "${PROJECT_DIR}/.polaris/config.json" >/dev/null 2>&1 || exit 0

payload="$(cat | jq -s '.[0] // {}' 2>/dev/null)" || exit 0

# The dispatch tool has been named both Task and Agent across versions, and the field naming the
# agent has moved with it. A gate that reads one name and the session uses the other never fires
# and never says so, which is the worst failure a gate has: it looks installed and allows
# everything. Read every name, and let the matcher in hooks.json admit both tools.
requested="$(printf '%s' "$payload" | jq -r \
    '.tool_input.subagent_type // .tool_input.agent_type // .tool_input.subagentType // ""' 2>/dev/null)"
[ -n "$requested" ] || exit 0

# The model floor, checked before the phase gate because it applies whether or not a run is open.
# rules/model-routing.md has been policy nothing enforced: an agent carries a model in frontmatter,
# and a dispatch can override it, so the cheapest tier was always one argument away on the work that
# least tolerates it. A dispatch with no explicit model is left alone; the frontmatter is the policy
# there, and refusing those would break every existing call site.
asked="$(printf '%s' "$payload" | jq -r '.tool_input.model // ""' 2>/dev/null)"
if [ -n "$asked" ] && [ -f "${ROOT}/rules/model-floor.json" ]; then
    bare="${requested##*:}"
    floor="$(jq -r --arg a "$bare" '.floor[$a] // ""' "${ROOT}/rules/model-floor.json")"
    if [ -n "$floor" ]; then
        rank() { jq -r --arg m "$1" '.tiers | index($m) // -1' "${ROOT}/rules/model-floor.json"; }
        want="$(rank "$asked")"; need="$(rank "$floor")"
        if [ "$want" -ge 0 ] && [ "$want" -lt "$need" ]; then
            reason="Polaris: ${bare} runs on ${floor} or better, and this dispatch asked for ${asked}. It is the judgment work, so the tier is a floor rather than a default. Drop the model argument to take the agent's own tier, or name ${floor} or above."
            jq -cn --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
            exit 0
        fi
    fi
fi

state="$(CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" get 2>/dev/null || true)"
[ -n "$state" ] || exit 0

flow="$(printf '%s' "$state" | jq -r .flow)"
phase="$(printf '%s' "$state" | jq -r .current)"
[ -n "$phase" ] && [ "$phase" != "null" ] || exit 0

target="$(CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" target 2>/dev/null || true)"
case "$target" in agent:*) ;; *) exit 0 ;; esac

# A plugin agent answers to both its bare name and its namespaced one, and the catalog stores the
# bare one. Compare against both rather than making every flow row carry the prefix.
want="${target#agent:}"
case "$requested" in
    "$want"|*":${want}") exit 0 ;;
esac

reason="Polaris: run '$(printf '%s' "$state" | jq -r .slug)' is on phase '${phase}' of the ${flow} flow, which runs ${target}. A dispatch to '${requested}' skips it.
Run ${target} and record the phase with scripts/run-state.sh record ${phase} <artifact> <evidence>, or run /polaris:pause if this flow is wrong."
jq -cn --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
exit 0
