#!/usr/bin/env bash
# Stop: drive the open run to its next phase, or to the human it is waiting on.
#
# This is the flow engine. A workflow cannot take input mid-run, so sign-off cannot happen inside a
# phase; it happens between phases, at the end of a turn, here. The hook reads the ledger and
# decides one of three things: the current phase was never recorded, so ask for it; the current
# phase stops for a human, so ask for the approval; the flow is finished, so say nothing.
#
# It blocks at most once per phase transition, keyed by session, slug, and phase. A gate with no
# exit gets switched off within a week, and a gate that is off enforces nothing. The marker is a
# directory because mkdir is atomic and does not follow symlinks; when it cannot be created, for
# any reason, this hook stays silent rather than risk blocking every turn.
#
# It also recommends a /clear once a phase is approved, which is the only lever Polaris has on the
# dominant cost term: the feature flow runs four phases as one conversation, and every request pays
# for the whole history. The recommendation is gated on run-state.sh assert, so it never fires over
# work the ledger cannot replace.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

command -v jq >/dev/null 2>&1 || exit 0
[ -f "${PROJECT_DIR}/.polaris/config.json" ] || exit 0
jq -e '.routing != false' "${PROJECT_DIR}/.polaris/config.json" >/dev/null 2>&1 || exit 0

payload="$(cat | jq -s '.[0] // {}' 2>/dev/null)" || exit 0
case "$(printf '%s' "$payload" | jq -r '.stop_hook_active // false')" in
    true|True|TRUE|1) exit 0 ;;
esac

session="$(printf '%s' "$payload" | jq -r 'if (.session_id|type)=="string" then .session_id else "" end')"
case "$session" in
    ""|.|..) exit 0 ;;
    *[!A-Za-z0-9._-]*) exit 0 ;;
esac
[ "${#session}" -le 128 ] || exit 0

state="$(CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" get 2>/dev/null || true)"
[ -n "$state" ] || exit 0

slug="$(printf '%s' "$state" | jq -r .slug)"
flow="$(printf '%s' "$state" | jq -r .flow)"
phase="$(printf '%s' "$state" | jq -r .current)"

# An empty current phase means the last phase advanced past the end: the flow is done and there is
# nothing to drive. Saying so every turn from here on would be noise.
[ -n "$phase" ] && [ "$phase" != "null" ] || exit 0

target="$(CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" target 2>/dev/null || true)"
status="$(printf '%s' "$state" | jq -r --arg p "$phase" '.record[$p].status // ""')"

# The three fan-out workflows read args.level to pick how many agents they dispatch: review runs 2,
# 8, 14 or 28. scripts/review-level.sh computes that from the diff, and until 2026-09-07 nothing
# connected the two, so every run took the `high` default and the whole four-level matrix was dead
# configuration. A workflow cannot shell out, and this hook is the one place that knows a workflow
# phase is about to start, so the level is computed here and named in the instruction.
level_hint=""
case "$target" in
    workflow:review|workflow:verify|workflow:build)
        lvl="$(cd "$PROJECT_DIR" 2>/dev/null && git diff --numstat 2>/dev/null \
            | bash "${ROOT}/scripts/review-level.sh" 2>/dev/null || true)"
        if [ -z "$lvl" ]; then
            lvl="$(cd "$PROJECT_DIR" 2>/dev/null && git diff --numstat HEAD~1 2>/dev/null \
                | bash "${ROOT}/scripts/review-level.sh" 2>/dev/null || true)"
        fi
        if [ -n "$lvl" ]; then
            level_hint="
The changeset rates '${lvl}', so pass it: args.level = \"${lvl}\". That is what decides the fan-out, and without it the workflow runs its widest default over a diff that may not need it. A human asking for the deepest pass names 'critical' instead."
        else
            level_hint="
There is no diff to rate, so the workflow would take its widest default. Rate the changeset before dispatching: git diff --numstat | bash ${ROOT}/scripts/review-level.sh, and pass the answer as args.level."
        fi
        ;;
esac

if [ "$status" = "done" ]; then
    instructions="Polaris run '${slug}' (${flow} flow): phase '${phase}' is recorded and stops for a human. Present its artifact and its evidence, then stop and wait. When the human approves, run: scripts/run-state.sh approve ${phase}"
else
    recorded="$(printf '%s' "$state" \
        | jq -r '[.record[] | select(.status=="done" and ((.artifact // "") != ""))] | sort_by(.at) | (last // {}) | .artifact // ""' 2>/dev/null)"
    if [ -n "$recorded" ] && [ -f "$recorded" ] \
        && CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" assert "$phase" >/dev/null 2>&1; then
        instructions="Polaris run '${slug}' (${flow} flow) is on phase '${phase}', which runs ${target}${level_hint} and has not been recorded. Every phase before '${phase}' is recorded and hash-checked, and every approval those phases ask for is stamped, so this conversation holds nothing the ledger does not. Do not start '${phase}' in this turn: tell the user run '${slug}' stays open, ${recorded} stays on disk, and they may run /clear now before starting '${phase}'; the next prompt is told both. This is a recommendation, not a requirement. Without a clear, run '${phase}' then record it: scripts/run-state.sh record ${phase} <artifact> <evidence>. If this flow is wrong for the task, say so and run /polaris:pause."
    else
        instructions="Polaris run '${slug}' (${flow} flow) is on phase '${phase}', which runs ${target}${level_hint}
It has not been recorded. Run it, then record it: scripts/run-state.sh record ${phase} <artifact> <evidence>. If this flow is wrong for the task, say so and run /polaris:pause."
    fi
fi

# A run that records nothing is a misroute, and it should drop itself rather than nag forever.
#
# Routing is a regex table over natural language, so it will always be wrong sometimes: measured
# over 96 real run-opening prompts, a quarter opened on a follow-up and a tenth on a question. The
# cost of being wrong is not the wrong name, it is this hook asking for a phase nobody meant to
# start, every turn, until someone remembers /polaris:pause. That asymmetry is why a correct route
# is invisible and a misroute feels like the only thing Polaris does.
#
# So: count the asks for a run that has recorded nothing, and after REAP_AFTER of them, clear it and
# say so once. A real run survives trivially, because recording its first phase resets the count to
# irrelevant. Nothing is lost either way, since clear archives to .done/ rather than deleting.
REAP_AFTER=3
recorded_count="$(printf '%s' "$state" | jq -r '.record | length' 2>/dev/null || echo 0)"
if [ "${recorded_count:-0}" = 0 ]; then
    nag_dir="${TMPDIR:-/tmp}/polaris-unrecorded/${session}-${slug}"
    mkdir -p "$nag_dir" 2>/dev/null
    nags=$(( $(ls "$nag_dir" 2>/dev/null | wc -l | tr -d ' ') + 1 ))
    : > "${nag_dir}/${nags}" 2>/dev/null
    if [ "$nags" -ge "$REAP_AFTER" ]; then
        if CLAUDE_PROJECT_DIR="$PROJECT_DIR" bash "${ROOT}/scripts/run-state.sh" clear >/dev/null 2>&1; then
            rm -rf "$nag_dir" 2>/dev/null
            jq -cn --arg r "Polaris dropped run '${slug}': it was opened on this prompt's classification as ${flow} and recorded no phase in ${REAP_AFTER} turns, which is what a misroute looks like. The ledger is archived under .polaris/runs/.done/. Nothing else to do; carry on with the work."                 '{hookSpecificOutput:{hookEventName:"Stop",additionalContext:$r}}'
            exit 0
        fi
    fi
fi

# Claim the transition before emitting. A second stop on the same phase loses the race and stays
# silent, so the user can always end the turn by ending it twice.
marker="${TMPDIR:-/tmp}/polaris-advance-flow"
mkdir -p -m 700 "$marker" 2>/dev/null
mkdir -m 700 "${marker}/${session}-${slug}-${phase}-${status:-open}" 2>/dev/null || exit 0

jq -cn --arg r "$instructions" '{decision:"block",reason:$r}'
exit 0
