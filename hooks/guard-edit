#!/usr/bin/env bash
# PreToolUse on Edit|Write: run the deterministic code check over the content about to be written.
# An inline comment denies the write; every other finding is advisory context.
#
# This ran on PostToolUse until 2026-09-07 and could not do its job there. The hooks reference is
# explicit that PostToolUse cannot block ("the tool already ran"), so the `decision: block` this hook
# emitted was read by nobody, and the comment law CLAUDE.md described as blocking was advisory for
# the plugin's whole life. It had fired in 2 sessions out of roughly 900.
#
# PreToolUse honours permissionDecision, so the law is now enforceable. Two things get better in
# the move: the bad content never reaches the file, so there is nothing to clean up after a refusal,
# and the two-strike counter is gone. That counter existed to stop a block-loop on a file the writer
# could not get clean; a denial that prevents the write cannot loop, because the file on disk never
# changes and the writer is told exactly which line to drop.
#
# Runs unless the project config sets guardEdit false.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${CLAUDE_PLUGIN_ROOT:-${SCRIPT_DIR}/..}"

cfg="${CLAUDE_PROJECT_DIR:-$PWD}/.polaris/config.json"
[ -f "$cfg" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
jq -e '.guardEdit != false' "$cfg" >/dev/null 2>&1 || exit 0

input="$(cat | jq -s '.[0] // {}' 2>/dev/null)" || exit 0
file="$(printf '%s' "$input" | jq -r '.tool_input.file_path // ""')"
[ -n "$file" ] || exit 0

# Only files some class in patterns.json reads: the four languages, markup and styles for ui, and
# SQL and CI config for the migration and ci classes. Anything else has nothing to check.
case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.py|*.go|*.rs|*.vue|*.svelte|*.astro|*.html|*.css|*.scss|*.sql|*.yml|*.yaml) ;;
    *) exit 0 ;;
esac

# Write takes the whole file; Edit takes the replacement. Check whichever arrived, because the
# content on disk is not yet what this call is about to make it.
content="$(printf '%s' "$input" | jq -r '.tool_input.content // .tool_input.new_string // ""')"
[ -n "$content" ] || exit 0

# check-patterns.sh picks its rules off the path: the extension for the language, and the name and
# directories for the test, migration, and ci classes. So the content is staged at the file's own
# relative path inside a temp dir; a temp named only by extension never ran those three classes.
stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/polaris-guard-edit.XXXXXX")" || exit 0
rel="${file#"${CLAUDE_PROJECT_DIR:-$PWD}"/}"
# The path comes from the tool call and this runs before the permission decision, so a `..` segment
# must never reach the join: dropping every `.` and `..` keeps the staged copy inside stage_dir.
rel="$(printf '%s' "$rel" | tr '/' '\n' | awk 'NF && $0 != "." && $0 != ".."' | paste -sd/ -)"
[ -n "$rel" ] || { rm -rf "$stage_dir"; exit 0; }
staged="${stage_dir}/${rel}"
mkdir -p "$(dirname "$staged")" 2>/dev/null || { rm -rf "$stage_dir"; exit 0; }
printf '%s\n' "$content" > "$staged"
out="$(CLAUDE_PLUGIN_ROOT="$ROOT" bash "${ROOT}/scripts/check-patterns.sh" code "$staged" 2>/dev/null \
    | STAGED="$staged" REAL="$file" awk 'index($0, ENVIRON["STAGED"] ":") == 1 { $0 = ENVIRON["REAL"] substr($0, length(ENVIRON["STAGED"]) + 1) } { print }')"
rm -rf "$stage_dir"
[ -z "$out" ] && exit 0

blocking="$(printf '%s\n' "$out" | grep 'inline-comment:' || true)"
if [ -n "$blocking" ]; then
    reason="Polaris comment law: no inline comments. This write was refused, so ${file} is unchanged.
${blocking}

Rename the variable, extract the function, or delete the line, then write again. If the fact is one
the code cannot carry, move it to a doc comment above the declaration, in the language's multi-line
doc syntax. The line numbers above are within the content you submitted. See the comments policy in
rules/core.md."
    jq -cn --arg r "$reason" \
      '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
    exit 0
fi

# Advisory findings carry additionalContext and no permissionDecision on purpose. Returning "allow"
# here would auto-approve the write and skip the user's own permission rules, which is a bigger
# change than surfacing a naming smell is worth.
jq -cn --arg c "Polaris: possible slop in the content for ${file}:
${out}" '{hookSpecificOutput:{hookEventName:"PreToolUse",additionalContext:$c}}'
exit 0
