{
  "prose": {
    "banned_words": [
      "delve",
      "tapestry",
      "pivotal",
      "underscore",
      "testament",
      "vibrant",
      "showcase",
      "seamless",
      "leverage",
      "intricate",
      "robust",
      "nestled",
      "boasts",
      "groundbreaking",
      "fostering",
      "cultivating",
      "holistic",
      "synergy",
      "cutting-edge"
    ],
    "banned_regex": [
      {
        "id": "not-only-but",
        "pattern": "not only .* but( also)?",
        "message": "banned structure: not only X but Y"
      },
      {
        "id": "em-dash-spray",
        "pattern": " \u2014 .* \u2014 ",
        "message": "em-dash spray; use commas or periods"
      },
      {
        "id": "importance-preamble",
        "pattern": "it is (important|worth) (to note|noting)",
        "message": "importance preamble; state the fact directly"
      },
      {
        "id": "ai-coauthor",
        "pattern": "co-authored-by:.*(claude|gpt|copilot|anthropic|openai)",
        "message": "no AI co-author trailer in commits or PRs"
      },
      {
        "id": "ai-attribution",
        "pattern": "(generated with|written by|authored by|created by).*(claude|chatgpt|copilot|anthropic|openai|an ai)",
        "message": "no AI attribution in commits, PRs, or code"
      }
    ]
  },
  "code": {
    "ts": [
      {
        "id": "as-any",
        "pattern": "\\bas any\\b",
        "message": "no as any; use a proper type"
      },
      {
        "id": "ts-ignore",
        "pattern": "@ts-(ignore|expect-error)",
        "message": "no ts-ignore without a documented framework bug"
      },
      {
        "id": "console",
        "pattern": "console\\.(log|debug)",
        "message": "remove debug logging"
      },
      {
        "id": "todo",
        "pattern": "//\\s*(TODO|FIXME)",
        "message": "no deferred TODO/FIXME"
      },
      {
        "id": "inline-comment",
        "pattern": "\\S[ \\t]+//",
        "message": "no inline comment; rename or extract instead. Doc comments only, above the declaration"
      }
    ],
    "py": [
      {
        "id": "bare-except",
        "pattern": "except\\s*:",
        "message": "no bare except; catch a specific exception"
      },
      {
        "id": "type-ignore",
        "pattern": "#\\s*type:\\s*ignore",
        "message": "no type: ignore without a documented reason"
      },
      {
        "id": "wildcard-import",
        "pattern": "from\\s+[\\w.]+\\s+import\\s+\\*",
        "message": "no wildcard import"
      },
      {
        "id": "todo",
        "pattern": "#\\s*(TODO|FIXME)",
        "message": "no deferred TODO/FIXME"
      },
      {
        "id": "inline-comment",
        "pattern": "\\S[ \\t]+#",
        "message": "no inline comment; rename or extract instead. Docstrings only, at the top of the file or the definition"
      }
    ],
    "go": [
      {
        "id": "panic",
        "pattern": "\\bpanic\\(",
        "message": "no panic in library code; return an error"
      },
      {
        "id": "todo",
        "pattern": "//\\s*(TODO|FIXME)",
        "message": "no deferred TODO/FIXME"
      },
      {
        "id": "inline-comment",
        "pattern": "\\S[ \\t]+//",
        "message": "no inline comment; rename or extract instead. Doc comments only, above the declaration"
      }
    ],
    "rust": [
      {
        "id": "unwrap",
        "pattern": "\\.unwrap\\(\\)",
        "message": "no .unwrap(); handle the error or expect() with context"
      },
      {
        "id": "dbg",
        "pattern": "\\bdbg!\\(",
        "message": "remove dbg! debug macro"
      },
      {
        "id": "todo-macro",
        "pattern": "\\b(todo|unimplemented)!\\(",
        "message": "no todo!()/unimplemented!() left in code"
      },
      {
        "id": "todo",
        "pattern": "//\\s*(TODO|FIXME)",
        "message": "no deferred TODO/FIXME"
      },
      {
        "id": "inline-comment",
        "pattern": "\\S[ \\t]+//",
        "message": "no inline comment; rename or extract instead. Doc comments only, above the declaration"
      }
    ]
  },
  "injection": {
    "phrases": [
      "(ignore|disregard|forget|override|bypass) (the |all |any |your |these |those |previous |prior |earlier |above )*(instruction|guidance|rule|prompt|direction|command)",
      "(ignore|disregard|forget|override) (the )?(above|previous|prior|earlier|preceding|foregoing)",
      "you are now (a |an |the )?",
      "(reveal|print|show|repeat|output|share|expose|leak|disclose|dump) (me |us )?(your|the) (system |initial |original |developer )?(prompt|instruction|rule|guideline|configuration)",
      "(system|developer) prompt",
      "new instructions?:",
      "exfiltrat",
      "act as (a |an )?(dan|jailbreak|unrestricted|unfiltered)"
    ]
  },
  "routing": [
    {
      "class": "context",
      "patterns": [
        "where was i",
        "where did i leave",
        "catch me up",
        "what was i (doing|working on)",
        "pick up where"
      ]
    },
    {
      "class": "ship",
      "_why": "Commit, push, open a PR, get CI green. agent:shipper existed only as a phase inside other flows, so the single most common developer instruction routed nowhere: 'commit and push frontend, ensure you are on dev branch' and 'raise a pr from login flow refactor to main' both landed in unknown on 2026-09-07.",
      "patterns": [
        "^(commit|push|ship)\\b",
        "\\b(commit|push) (and (commit|push) )?(this|these|it|them|the|everything|all|both|remaining|changes|plugin|backend|frontend|dashboard)\\b",
        "\\b(commit|push) (it|them|this|that|everything|all) (to|into|up)\\b",
        "\\b(raise|open|create|make|cut|send) (a |an |the )?(pr|pull request|mr|merge request)\\b",
        "\\b(pr|pull request|mr) (from|to|against|off) \\w",
        "\\bget (ci|the build|the pipeline|tests) (green|passing|to pass)\\b",
        "\\b(squash|rebase) and (merge|push)\\b",
        "\\bmerge (this|it|the (pr|branch))\\b",
        "\\bpush (both|all|everything)\\b"
      ]
    },
    {
      "class": "incident",
      "patterns": [
        "\\bincident\\b",
        "\\boutage\\b",
        "(prod|production|the site|the api) is (down|broken)",
        "users (can'?t|cannot)",
        "\\bsev-?[0-9]"
      ]
    },
    {
      "class": "release",
      "patterns": [
        "cut (a|the) release",
        "\\brelease\\b.*(version|tag|notes)",
        "tag (a|the) version",
        "bump the version",
        "ship (a|the) release"
      ]
    },
    {
      "class": "audit",
      "patterns": [
        "\\baudit\\b",
        "(whole|entire) (code ?base|repo|project)",
        "(find|look for) problems across",
        "how healthy is"
      ]
    },
    {
      "class": "security",
      "patterns": [
        "threat ?model",
        "\\bharden\\b",
        "security (pass|review|audit)",
        "vulnerab",
        "\\bpentest\\b",
        "attack surface"
      ]
    },
    {
      "class": "spike",
      "patterns": [
        "\\bspike\\b",
        "proof of concept",
        "\\bpoc\\b",
        "feasib",
        "throwaway",
        "can we even"
      ]
    },
    {
      "class": "research",
      "patterns": [
        "\\bresearch\\b",
        "\\bcompetitors?\\b",
        "prior art",
        "compare (three|our|the) ",
        "what do other (teams|products|companies)"
      ]
    },
    {
      "class": "modernize",
      "patterns": [
        "\\bupgrade\\b",
        "bump (the )?(deps|dependencies|.* to v?[0-9])",
        "migrate (to|from) ",
        "out ?of ?date (deps|dependencies|packages)"
      ]
    },
    {
      "class": "docs",
      "patterns": [
        "(the )?docs? (are|is|have) (out of date|stale|wrong|drift)",
        "update the (docs|documentation|readme)",
        "document the "
      ]
    },
    {
      "class": "cleanup",
      "patterns": [
        "clean ?up",
        "remove (the )?(ai )?slop",
        "\\btidy\\b",
        "bring .* up to standard"
      ]
    },
    {
      "class": "review",
      "patterns": [
        "review (this|the|my) (pr|diff|change|branch|code)",
        "\\bpr #?[0-9]+",
        "look over (this|my) (pr|diff)"
      ]
    },
    {
      "class": "qa",
      "patterns": [
        "\\bqa\\b",
        "try to break",
        "pressure.?test",
        "break (this|the) (feature|flow)",
        "test it hard"
      ]
    },
    {
      "class": "bug",
      "patterns": [
        "\\bbug\\b",
        "\\bbroken\\b",
        "(is|are|keeps) failing",
        "does ?n'?t work",
        "not working",
        "\\bcrash",
        "\\bregression\\b",
        "throws? an error",
        "returns? the wrong",
        "accepts? duplicates",
        "comes? out wrong",
        "should ?n'?t (be|happen)"
      ]
    },
    {
      "class": "conversation",
      "patterns": [
        "^(what|how|why|where|which|who|when) (does|do|is|are|did|the|this|that)",
        "^explain\\b",
        "walk me through",
        "^tell me (about|how|what)",
        "how (does|do) (it|this|that|the) work"
      ]
    },
    {
      "class": "trivial",
      "patterns": [
        "\\btypo\\b",
        "\\brename\\b",
        "one.?liner",
        "fix the spelling",
        "wrong (word|label|copy) "
      ]
    },
    {
      "class": "foggy",
      "patterns": [
        "not sure (how|where|what)",
        "no idea (how|where)",
        "figure out how we",
        "\\brethink\\b",
        "\\boverhaul\\b",
        "from scratch",
        "big (effort|project|change)"
      ]
    },
    {
      "class": "feature",
      "patterns": [
        "\\badd (a|an|the) ",
        "\\bbuild (a|an|the) ",
        "\\bimplement\\b",
        "\\bcreate (a|an|the) ",
        "new (feature|page|endpoint|component|screen)",
        "support for ",
        "users should be able to"
      ]
    },
    {
      "class": "fix",
      "patterns": [
        "\\bfix (the|this|that) ",
        "\\bchange (the|this) ",
        "\\bupdate (the|this) ",
        "\\badjust\\b",
        "\\btweak\\b",
        "make (it|the) .* (instead|rather)"
      ]
    },
    {
      "class": "continuation",
      "_why": "A follow-up inside work already under way, and the LAST class tried rather than the first. Put first, it swallowed the follow-ups that carry real work: 'also push both backend and frontend to github' is a ship instruction wearing an 'also'. Tried last it means only what it should: nothing else matched, and this reads like a continuation rather than a new task. Measured on 800 real prompts, that moved unknown from 90.8% to 61.6% with the real classes still winning. A continuation opens nothing and says nothing; when a run is open, enhance-prompt already treats the prompt as input to it.",
      "patterns": [
        "^(also|and|plus|additionally|btw|by the way|oh)\\b",
        "^(ok|okay|cool|nice|great|perfect|thanks|thank you|yes|yeah|yep|no|nope|nah|sure|right|correct|exactly)\\b",
        "^(now|next|then|after that|finally)\\b",
        "^(continue|carry on|keep going|go on|go ahead|proceed|resume)\\b",
        "^(try again|again|retry|redo|once more)\\b",
        "^(instead|rather|actually|wait|hold on|hmm)\\b",
        "^(that|this|it|these|those) (is|was|are|were|looks|seems|still|does|did|should|needs)\\b",
        "^(here|there) (is|are|you go)\\b",
        "^(what|how) about\\b",
        "^(same|similar|likewise|ditto)\\b",
        "^(not|dont|don't|do not) (like|that|this|it)\\b",
        "^(still|already) (broken|failing|wrong|not|the same)\\b",
        "^(fix|change|update|add|remove) (it|this|that|them)\\b",
        "^(revert|undo|roll back|rollback)\\b",
        "^(and|but|so) (now|then|what|why|how|can|should)\\b",
        "^(do|make) (it|this|that|them) (again|properly|right|the same way)\\b"
      ]
    }
  ]
}
